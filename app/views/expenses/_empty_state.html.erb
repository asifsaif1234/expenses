<!-- app/views/expenses/_empty_state.html.erb -->

<div class="text-center py-12 text-gray-400">

  <i class="fas fa-calendar-times text-4xl block mb-3 text-gray-300"></i>

  <p class="text-lg font-medium text-gray-500">
    No expenses in <%= @month_name %>
  </p>

  <p class="text-sm">
    Start tracking your expenses by adding one!
  </p>

  <button
    type="button"
    class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium cursor-pointer rounded-lg hover:bg-indigo-700 transition-colors"
    data-controller="modal-trigger"
    data-action="click->modal-trigger#open"
    data-modal-trigger-url="<%= new_expense_path %>"
  >
    <i class="fas fa-plus"></i>
    Add Your First Expense
  </button>

</div>