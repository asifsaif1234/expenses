<!-- app/views/expenses/_expense_list.html.erb -->

<div class="lg:col-span-2">

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">

    <!-- Header -->
    <div class="bg-gray-50 px-6 py-3 border-b border-gray-200">

      <div class="flex items-center justify-between text-xs font-semibold text-gray-500 uppercase tracking-wider">

        <div class="flex items-center gap-2">
          <i class="fas fa-align-left text-gray-400"></i>
          Description
        </div>

        <div class="flex items-center gap-2">
          <i class="fas fa-dollar-sign text-gray-400"></i>
          Amount
        </div>

      </div>

    </div>


    <!-- Rows -->
    <div
      id="expenses_list"
      class="divide-y divide-gray-100"
    >

      <% if @expenses.any? %>

        <%= render(
          partial: "expense",
          collection: @expenses,
          as: :expense
        ) %>

      <% else %>

        <%= render "empty_state" %>

      <% end %>

    </div>


    <!-- Infinite Scroll -->
    <% if @pagy.next %>

      <%= render "infinite_scroll_sentinel" %>

    <% else %>

      <div
        id="infinite_scroll_end"
        class="bg-gray-50 px-6 py-3 border-t border-gray-200 text-center"
      >
        <p class="text-sm text-gray-400">

          <i class="fas fa-check-circle mr-1"></i>

          <%= @pagy.count.positive? ? "You've reached the end" : "No transactions" %>

          • Showing all

          <span class="font-semibold">
            <%= @pagy.count %>
          </span>

          <%= "transaction".pluralize(@pagy.count) %>

        </p>
      </div>

    <% end %>


    <!-- Bottom navigation -->
    <div class="bg-white px-6 py-4 border-t border-gray-200">
      <%= render "month_navigation" %>
    </div>

  </div>

</div>