<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="space-y-6">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">
          <i class="fas fa-wallet text-indigo-600 mr-2"></i>Expenses
        </h1>
        <p class="text-sm text-gray-500">
          Showing <span class="font-semibold text-gray-700"><%= @month_name %></span> transactions
        </p>
      </div>
      <button type="button"
              class="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white text-sm font-medium cursor-pointer rounded-lg hover:shadow-lg transform hover:scale-105 transition-all duration-200"
              data-controller="modal-trigger"
              data-action="click->modal-trigger#open"
              data-modal-trigger-url="<%= new_expense_path %>">
        <i class="fas fa-plus"></i>
        <span>Add Expense</span>
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-500 font-medium"><%= Date.today.year %> Total</p>
            <p class="text-2xl font-bold text-gray-900 mt-1 tabular-nums">
              $<%= number_with_precision(@year_total, precision: 2, delimiter: ',') %>
            </p>
            <p class="text-xs text-gray-400"><%= pluralize(@year_count, "transaction") %> this year</p>
          </div>
          <div class="w-12 h-12 bg-indigo-50 rounded-xl flex items-center justify-center">
            <i class="fas fa-chart-line text-indigo-600 text-xl"></i>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-500 font-medium">Avg Monthly</p>
            <p class="text-2xl font-bold text-purple-600 mt-1 tabular-nums">
              $<%= number_with_precision(@year_avg_monthly, precision: 2, delimiter: ',') %>
            </p>
            <p class="text-xs text-gray-400"><%= @year_month_count %> months tracked</p>
          </div>
          <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center">
            <i class="fas fa-calendar-week text-purple-600 text-xl"></i>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-500 font-medium"><%= @month_name %> Total</p>
            <p class="text-2xl font-bold text-red-600 mt-1 tabular-nums">
              $<%= number_with_precision(@month_total, precision: 2, delimiter: ',') %>
            </p>
            <p class="text-xs text-gray-400"><%= pluralize(@month_count, "transaction") %></p>
          </div>
          <div class="w-12 h-12 bg-red-50 rounded-xl flex items-center justify-center">
            <i class="fas fa-calendar-alt text-red-600 text-xl"></i>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-500 font-medium">Avg Daily</p>
            <p class="text-2xl font-bold text-green-600 mt-1 tabular-nums">
              $<%= number_with_precision(@avg_daily, precision: 2, delimiter: ',') %>
            </p>
            <p class="text-xs text-gray-400">
              Avg trans: $<%= number_with_precision(@avg_transaction, precision: 2) %>
            </p>
          </div>
          <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center">
            <i class="fas fa-coins text-green-600 text-xl"></i>
          </div>
        </div>
      </div>
    </div>

    <%= render "month_navigator" %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <%= render "category_breakdown" %>
      
      <!-- Expenses List -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          
          <!-- Table Header -->
          <div class="bg-gray-50 px-6 py-3 border-b border-gray-200">
            <div class="flex items-center justify-between text-xs font-semibold text-gray-500 uppercase tracking-wider">
              <div class="flex items-center gap-2">
                <i class="fas fa-align-left text-gray-400"></i>
                Description
              </div>
              <div class="flex items-center gap-2">
                <i class="fas fa-dollar-sign text-gray-400"></i>
                Amount
              </div>
            </div>
          </div>

          <!-- Expenses List -->
          <div id="expenses_list" class="divide-y divide-gray-100">
            <% if @expenses.any? %>
              <%= render partial: "expense", collection: @expenses, as: :expense %>
            <% else %>
              <div class="text-center py-12 text-gray-400">
                <i class="fas fa-calendar-times text-4xl block mb-3 text-gray-300"></i>
                <p class="text-lg font-medium text-gray-500">No expenses in <%= @month_name %></p>
                <p class="text-sm">Start tracking your expenses by adding one!</p>
                <button type="button"
                        class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium cursor-pointer rounded-lg hover:bg-indigo-700 transition-colors"
                        data-controller="modal-trigger"
                        data-action="click->modal-trigger#open"
                        data-modal-trigger-url="<%= new_expense_path %>">
                  <i class="fas fa-plus"></i>
                  Add Your First Expense
                </button>
              </div>
            <% end %>
          </div>

          <% if @pagy.next %>
            <!-- Sentinel for infinite scroll -->
            <div id="infinite_scroll_sentinel"
                 data-controller="infinite-scroll"
                 data-infinite-scroll-next-url-value="<%= expenses_path(page: @pagy.next, month: params[:month]) %>"
                 class="h-4 w-full">
            </div>

            <!-- Loading indicator -->
            <div id="infinite_scroll_loading" 
                 style="display: none;"
                 class="bg-gray-50 px-6 py-4 border-t border-gray-200 text-center">
              <div class="flex items-center justify-center gap-2">
                <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-indigo-600"></div>
                <span class="text-sm text-gray-500">Loading more expenses...</span>
              </div>
            </div>
          <% end %>

          <!-- End message (ALWAYS rendered, hidden if more pages exist) -->
          <div id="infinite_scroll_end" 
               style="<%= @pagy.next ? 'display: none;' : '' %>"
               class="bg-gray-50 px-6 py-3 border-t border-gray-200 text-center">
            <p class="text-sm text-gray-400">
              <i class="fas fa-check-circle mr-1"></i>
              <%= @pagy.count > 0 ? "You've reached the end" : "No transactions" %> • 
              Showing all <span class="font-semibold"><%= @pagy.count %></span> 
              <%= "transaction".pluralize(@pagy.count) %>
            </p>
          </div>
          <div class="bg-white px-6 py-4 border-t border-gray-200">
            <%= render "month_navigator" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>