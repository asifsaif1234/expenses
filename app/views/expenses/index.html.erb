<!-- app/views/expenses/index.html.erb -->

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">

      <div>
        <h1 class="text-2xl font-bold text-gray-900">
          <i class="fas fa-wallet text-indigo-600 mr-2"></i>
          Expenses
        </h1>

        <p class="text-sm text-gray-500">
          Showing
          <span class="font-semibold text-gray-700">
            <%= @month_name %>
          </span>
          transactions
        </p>
      </div>

      <button
        type="button"
        class="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white text-sm font-medium cursor-pointer rounded-lg hover:shadow-lg transform hover:scale-105 transition-all duration-200"
        data-controller="modal-trigger"
        data-action="click->modal-trigger#open"
        data-modal-trigger-url="<%= new_expense_path %>"
      >
        <i class="fas fa-plus"></i>
        <span>Add Expense</span>
      </button>

    </div>

    <!-- Everything below this point is server-rendered and replaceable -->
    <div id="expenses_dashboard">
      <%= render "dashboard" %>
    </div>

  </div>
</div>

<!-- Keep this element permanently in the DOM -->
<div id="expense_modal"></div>