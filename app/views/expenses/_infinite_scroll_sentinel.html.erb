<!-- app/views/expenses/_infinite_scroll_sentinel.html.erb -->

<div
  id="infinite_scroll_sentinel"
  data-controller="infinite-scroll"
  data-infinite-scroll-next-url-value="<%= expenses_path(
    page: @pagy.next,
    month: @selected_month_param
  ) %>"
  class="h-4 w-full"
>
</div>

<div
  id="infinite_scroll_loading"
  style="display: none;"
  class="bg-gray-50 px-6 py-4 border-t border-gray-200 text-center"
>
  <div class="flex items-center justify-center gap-2">

    <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-indigo-600"></div>

    <span class="text-sm text-gray-500">
      Loading more expenses...
    </span>

  </div>
</div>