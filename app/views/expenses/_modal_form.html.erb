<!-- app/views/expenses/_modal_form.html.erb -->
<div data-controller="expense-form">
  <%= form_with(model: expense, 
                url: expense.persisted? ? expense_path(expense) : expenses_path,
                method: expense.persisted? ? :patch : :post,
                data: { 
                  action: "turbo:submit-end->expense-form#handleSubmit"
                }) do |f| %>
    
    <!-- Error Messages -->
    <% if expense.errors.any? %>
      <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
        <% expense.errors.full_messages.each do |msg| %>
          <p class="flex items-center gap-2">
            <i class="fas fa-exclamation-circle"></i>
            <%= msg %>
          </p>
        <% end %>
      </div>
    <% end %>

    <!-- Amount -->
    <div class="mb-4">
      <%= f.label :amount, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
        <span class="flex items-center gap-1.5">
          <i class="fas fa-dollar-sign text-indigo-500 text-xs"></i>
          Amount
        </span>
      <% end %>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <span class="text-gray-500 text-lg font-semibold">$</span>
        </div>
        <%= f.number_field :amount, 
            step: 0.01,
            min: 0,
            class: "w-full pl-8 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:bg-white transition-all duration-200 text-lg font-semibold",
            placeholder: "0.00",
            required: true,
            autofocus: true,
            inputmode: "decimal",
            data: { expense_form_target: "amount" } %>
      </div>
    </div>

    <!-- Date -->
    <div class="mb-4">
      <%= f.label :expense_date, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
        <span class="flex items-center gap-1.5">
          <i class="fas fa-calendar-alt text-indigo-500 text-xs"></i>
          Date
        </span>
      <% end %>
      <%= f.date_field :expense_date, 
          value: expense.expense_date&.strftime("%Y-%m-%d") || Date.today.strftime("%Y-%m-%d"),
          class: "w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:bg-white transition-all duration-200",
          required: true,
          data: { expense_form_target: "date" } %>
    </div>

    <!-- Category -->
    <div class="mb-4">
      <%= f.label :category_id, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
        <span class="flex items-center gap-1.5">
          <i class="fas fa-tag text-indigo-500 text-xs"></i>
          Category
        </span>
      <% end %>
      <%= f.collection_select :category_id, 
          categories, 
          :id, 
          :full_name, 
          { include_blank: "Select a category" }, 
          { class: "w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:bg-white transition-all duration-200",
            required: true,
            data: { expense_form_target: "category" } } %>
    </div>

    <!-- Description -->
    <div class="mb-6">
      <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
        <span class="flex items-center gap-1.5">
          <i class="fas fa-align-left text-indigo-500 text-xs"></i>
          Description
        </span>
      <% end %>
      <%= f.text_area :description, 
          rows: 3,
          class: "w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:bg-white transition-all duration-200",
          placeholder: "Add a description (optional)",
          data: { expense_form_target: "description" } %>
    </div>

    <!-- Form Actions -->
    <div class="flex items-center justify-end gap-3 border-t border-gray-100 pt-4">
      <button type="button" 
              data-action="click->modal#close" 
              class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-lg transition-colors cursor-pointer">
        Cancel
      </button>
      <%= f.submit expense.persisted? ? "Update Expense" : "Add Expense", 
          class: "px-6 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white text-sm font-medium rounded-lg hover:shadow-lg transform hover:scale-105 transition-all duration-200 cursor-pointer",
          data: { expense_form_target: "submit" } %>
    </div>
  <% end %>
</div>