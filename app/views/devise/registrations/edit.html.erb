<!-- app/views/devise/registrations/edit.html.erb -->
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  
  <!-- Page Header -->
  <div class="mb-6">
    <div class="flex items-center gap-3 mb-2">
      <%= link_to :back, 
          class: "flex items-center justify-center w-9 h-9 rounded-lg bg-white border border-gray-200 hover:bg-gray-50 transition-colors" do %>
        <i class="fas fa-arrow-left text-gray-600 text-sm"></i>
      <% end %>
      <div>
        <h1 class="text-2xl font-bold text-gray-900">
          <i class="fas fa-cog text-indigo-600 mr-2"></i>Settings
        </h1>
        <p class="text-sm text-gray-500 mt-0.5">Manage your account preferences and security</p>
      </div>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if notice %>
    <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-700 rounded-xl flex items-center justify-between">
      <div class="flex items-center gap-2">
        <i class="fas fa-check-circle"></i>
        <span class="text-sm"><%= notice %></span>
      </div>
    </div>
  <% end %>
  
  <% if alert %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl flex items-center justify-between">
      <div class="flex items-center gap-2">
        <i class="fas fa-exclamation-circle"></i>
        <span class="text-sm"><%= alert %></span>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Sidebar Navigation -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden sticky top-20">
        <nav class="p-2">
          <a href="#profile" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-700 bg-indigo-50 text-indigo-700">
            <i class="fas fa-user w-4 text-center"></i>
            Profile
          </a>
          <a href="#security" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
            <i class="fas fa-lock w-4 text-center"></i>
            Security
          </a>
          <a href="#danger" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
            <i class="fas fa-exclamation-triangle w-4 text-center"></i>
            Danger Zone
          </a>
        </nav>
      </div>
    </div>

    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      
      <%= form_for(resource, 
                   as: resource_name, 
                   url: registration_path(resource_name), 
                   html: { 
                     method: :put,
                     class: "space-y-6"
                   }) do |f| %>
        
        <!-- Error Messages -->
        <% if resource.errors.any? %>
          <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm">
            <div class="flex items-start gap-2">
              <i class="fas fa-exclamation-circle mt-0.5"></i>
              <div>
                <strong><%= pluralize(resource.errors.count, "error") %> prevented your settings from being saved:</strong>
                <ul class="mt-1 list-disc list-inside">
                  <% resource.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Profile Section -->
        <div id="profile" class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden scroll-mt-20">
          <div class="bg-gradient-to-r from-indigo-50 to-purple-50 px-6 py-4 border-b border-gray-100">
            <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <i class="fas fa-user-circle text-indigo-600"></i>
              Profile Information
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">Update your account email and personal details</p>
          </div>
          
          <div class="p-6 space-y-5">
            <!-- Email -->
            <div>
              <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
                <span class="flex items-center gap-1.5">
                  <i class="fas fa-envelope text-indigo-500 text-xs"></i>
                  Email Address
                </span>
              <% end %>
              <%= f.email_field :email, 
                  autofocus: true, 
                  autocomplete: "email",
                  class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:bg-white transition-all duration-200 text-sm" %>
              <p class="mt-1 text-xs text-gray-400">
                <i class="fas fa-info-circle mr-1"></i>
                We'll never share your email with anyone else
              </p>
            </div>

            <!-- First Name / Last Name (if you have these fields) -->
            <% if resource.respond_to?(:first_name) %>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <%= f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
                    <span class="flex items-center gap-1.5">
                      <i class="fas fa-user text-indigo-500 text-xs"></i>
                      First Name
                    </span>
                  <% end %>
                  <%= f.text_field :first_name, 
                      class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:bg-white transition-all duration-200 text-sm" %>
                </div>
                <div>
                  <%= f.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
                    <span class="flex items-center gap-1.5">
                      <i class="fas fa-user text-indigo-500 text-xs"></i>
                      Last Name
                    </span>
                  <% end %>
                  <%= f.text_field :last_name, 
                      class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:bg-white transition-all duration-200 text-sm" %>
                </div>
              </div>
            <% end %>

            <!-- Pending Reconfirmation -->
            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="p-3 bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg text-sm flex items-start gap-2">
                <i class="fas fa-clock mt-0.5"></i>
                <div>
                  Currently waiting confirmation for: <strong><%= resource.unconfirmed_email %></strong>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Security Section -->
        <div id="security" class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden scroll-mt-20">
          <div class="bg-gradient-to-r from-blue-50 to-indigo-50 px-6 py-4 border-b border-gray-100">
            <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <i class="fas fa-shield-alt text-blue-600"></i>
              Password & Security
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">Keep your account secure with a strong password</p>
          </div>
          
          <div class="p-6 space-y-5">
            <!-- New Password -->
            <div>
              <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
                <span class="flex items-center gap-1.5">
                  <i class="fas fa-key text-blue-500 text-xs"></i>
                  New Password
                  <span class="text-xs text-gray-400 font-normal ml-1">(leave blank to keep current)</span>
                </span>
              <% end %>
              <%= f.password_field :password, 
                  autocomplete: "new-password",
                  placeholder: "Enter new password",
                  class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:bg-white transition-all duration-200 text-sm" %>
              <% if @minimum_password_length %>
                <p class="mt-1 text-xs text-gray-400">
                  <i class="fas fa-info-circle mr-1"></i>
                  Minimum <%= @minimum_password_length %> characters
                </p>
              <% end %>
            </div>

            <!-- Password Confirmation -->
            <div>
              <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
                <span class="flex items-center gap-1.5">
                  <i class="fas fa-check-circle text-blue-500 text-xs"></i>
                  Confirm New Password
                </span>
              <% end %>
              <%= f.password_field :password_confirmation, 
                  autocomplete: "new-password",
                  placeholder: "Re-enter new password",
                  class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:bg-white transition-all duration-200 text-sm" %>
            </div>

            <!-- Divider -->
            <div class="relative my-2">
              <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-200"></div>
              </div>
              <div class="relative flex justify-center">
                <span class="px-3 bg-white text-xs text-gray-400">Required to save changes</span>
              </div>
            </div>

            <!-- Current Password -->
            <div>
              <%= f.label :current_password, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
                <span class="flex items-center gap-1.5">
                  <i class="fas fa-lock text-amber-500 text-xs"></i>
                  Current Password
                </span>
              <% end %>
              <%= f.password_field :current_password, 
                  autocomplete: "current-password",
                  placeholder: "Enter current password",
                  class: "w-full px-4 py-2.5 bg-amber-50 border border-amber-200 rounded-lg focus:border-amber-500 focus:ring-2 focus:ring-amber-100 focus:bg-white transition-all duration-200 text-sm" %>
              <p class="mt-1 text-xs text-amber-600">
                <i class="fas fa-shield-alt mr-1"></i>
                We need your current password to confirm your changes
              </p>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-end gap-3">
          <%= link_to "Cancel", :back, 
              class: "w-full sm:w-auto px-6 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors text-center" %>
          <%= f.submit "Save Changes", 
              class: "w-full sm:w-auto px-6 py-2.5 text-sm font-medium text-white bg-gradient-to-r from-indigo-600 to-purple-600 rounded-lg hover:shadow-lg transform hover:scale-[1.02] transition-all duration-200 cursor-pointer" %>
        </div>
        
      <% end %>

      <!-- Danger Zone -->
      <div id="danger" class="bg-white rounded-xl shadow-sm border border-red-100 overflow-hidden scroll-mt-20">
        <div class="bg-red-50 px-6 py-4 border-b border-red-100">
          <h2 class="text-lg font-semibold text-red-900 flex items-center gap-2">
            <i class="fas fa-exclamation-triangle text-red-600"></i>
            Danger Zone
          </h2>
          <p class="text-xs text-red-600 mt-0.5">Irreversible actions that affect your account</p>
        </div>
        
        <div class="p-6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-sm font-semibold text-gray-900">Delete Account</h3>
              <p class="text-xs text-gray-500 mt-0.5">
                Once you delete your account, all your expenses and data will be permanently removed. This action cannot be undone.
              </p>
            </div>
            <%= button_to registration_path(resource_name), 
                method: :delete,
                data: { 
                  confirm: "Are you sure? All your data will be permanently deleted.",
                  turbo_confirm: "Are you sure? All your data will be permanently deleted."
                },
                class: "flex-shrink-0 flex items-center gap-2 px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors cursor-pointer" do %>
              <i class="fas fa-trash-alt"></i>
              <span>Delete Account</span>
            <% end %>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</div>

<!-- Smooth scroll for anchor links -->
<script>
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>