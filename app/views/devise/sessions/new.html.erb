<!-- app/views/devise/sessions/new.html.erb -->
<div class="min-h-screen bg-gradient-to-br from-purple-600 via-indigo-600 to-blue-500 flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
  <div class="w-full max-w-md animate-slide-up">
    <!-- Brand -->
    <div class="text-center mb-8">
      <div class="flex items-center justify-center gap-3 mb-2">
        <span class="text-4xl bg-white/20 backdrop-blur-sm p-3 rounded-2xl shadow-lg">💰</span>
        <h2 class="text-3xl font-bold text-white tracking-tight">Expense Tracker</h2>
      </div>
      <p class="text-indigo-100 text-sm font-light">Welcome back! Sign in to your account</p>
    </div>

    <!-- Card -->
    <div class="bg-white/10 backdrop-blur-lg rounded-2xl shadow-2xl p-8 border border-white/20">
      <!-- Flash Messages -->
      <%= render "shared/flash_messages" %>

      <!-- Sign In Form -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        
        <!-- Email Field -->
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-white mb-1.5" do %>
            <span class="flex items-center gap-2">
              <i class="fas fa-envelope text-indigo-200"></i>
              Email Address
            </span>
          <% end %>
          <%= f.email_field :email, 
              class: "w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white/30 focus:border-transparent transition-all duration-200",
              placeholder: "john@example.com",
              autofocus: true,
              autocomplete: "email",
              required: true %>
        </div>

        <!-- Password Field -->
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <%= f.label :password, class: "block text-sm font-medium text-white" do %>
              <span class="flex items-center gap-2">
                <i class="fas fa-lock text-indigo-200"></i>
                Password
              </span>
            <% end %>
            <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
              <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-xs text-indigo-200 hover:text-white transition-colors duration-200" %>
            <% end %>
          </div>
          <div class="relative" data-controller="password-toggle">
            <%= f.password_field :password, 
                class: "w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white/30 focus:border-transparent transition-all duration-200 pr-12",
                placeholder: "Enter your password",
                autocomplete: "current-password",
                data: { password_toggle_target: "password" },
                required: true %>
            <button type="button" 
                    class="absolute inset-y-0 right-3 flex items-center text-white/50 hover:text-white transition-colors duration-200"
                    data-action="click->password-toggle#toggle"
                    data-password-toggle-target="button">
              <i class="fas fa-eye" data-password-toggle-target="icon"></i>
            </button>
          </div>
        </div>

        <!-- Remember Me -->
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-white/20 bg-white/10 text-white focus:ring-2 focus:ring-white/30 focus:ring-offset-0" %>
            <%= f.label :remember_me, class: "text-sm text-white/80" do %>
              <i class="fas fa-check-circle text-indigo-200 mr-1.5"></i>
              Remember me
            <% end %>
          </div>
        <% end %>

        <!-- Submit Button -->
        <%= f.submit "Sign In", class: "w-full py-3.5 px-4 bg-white text-indigo-600 font-semibold rounded-xl hover:bg-indigo-50 hover:shadow-lg transform hover:scale-[1.02] transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-white/30" %>
      <% end %>

      <!-- Divider -->
      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-white/20"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-4 bg-transparent text-white/60 text-xs uppercase tracking-wider">or continue with</span>
        </div>
      </div>

      <!-- Social Login Buttons -->
      <div class="space-y-2.5">
        <button class="w-full py-3 px-4 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl text-white hover:bg-white/20 transition-all duration-200 flex items-center justify-center gap-3 group">
          <i class="fab fa-google text-white/70 group-hover:text-white transition-colors"></i>
          <span class="text-sm font-medium">Continue with Google</span>
        </button>
        <button class="w-full py-3 px-4 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl text-white hover:bg-white/20 transition-all duration-200 flex items-center justify-center gap-3 group">
          <i class="fab fa-github text-white/70 group-hover:text-white transition-colors"></i>
          <span class="text-sm font-medium">Continue with GitHub</span>
        </button>
        <button class="w-full py-3 px-4 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl text-white hover:bg-white/20 transition-all duration-200 flex items-center justify-center gap-3 group">
          <i class="fab fa-apple text-white/70 group-hover:text-white transition-colors"></i>
          <span class="text-sm font-medium">Continue with Apple</span>
        </button>
      </div>

      <!-- Sign Up Link -->
      <div class="mt-6 text-center">
        <p class="text-sm text-white/70">
          Don't have an account?
          <%= link_to "Sign Up", new_registration_path(resource_name), class: "text-white font-semibold hover:underline ml-1 transition-colors" %>
        </p>
      </div>
    </div>
  </div>
</div>