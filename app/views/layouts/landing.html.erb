<!-- app/views/layouts/landing.html.erb -->
<!DOCTYPE html>
<html>
  <head>
    <title>Expense Tracker - Track Your Expenses & Manage Budgets</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Track your expenses, manage budgets, and take control of your finances with our easy-to-use expense tracker.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Stylesheets -->
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E💰%3C/text%3E%3C/svg%3E">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Additional styles for smooth scrolling -->
    <style>
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>

  <body class="font-['Inter'] antialiased bg-white">
    <!-- Use landing navbar for unauthenticated users -->
    <%= render "shared/landing_navbar" %>

    <!-- Main Content with padding for fixed navbar -->
    <main class="pt-16">
      <%= yield %>
    </main>
  </body>
</html>