<!-- app/views/shared/_modal.html.erb -->
<div class="fixed inset-0 z-50 hidden" 
     data-controller="modal" 
     data-modal-target="modal"
     data-action="keydown.esc->modal#close">
  
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" 
       data-action="click->modal#close"></div>
  
  <!-- Modal Container -->
  <div class="relative min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-y-auto 
                transform transition-all duration-300 scale-95 opacity-0 
                data-[show=true]:scale-100 data-[show=true]:opacity-100" 
         data-modal-target="container">
      
      <!-- Modal Header -->
      <div class="sticky top-0 bg-white border-b border-gray-200 
                  px-6 py-4 rounded-t-2xl flex items-center justify-between z-10">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <span class="text-2xl">💰</span>
          Add Expense
        </h3>
        <button data-action="click->modal#close" 
                class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <!-- Modal Body -->
      <div class="px-6 py-4" data-modal-target="body">
        <!-- Content will be loaded here directly -->
        <div id="modal_content" class="min-h-[200px]">
          <div class="flex flex-col items-center justify-center min-h-[200px] gap-3">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
            <p class="text-sm text-gray-500">Loading form...</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>