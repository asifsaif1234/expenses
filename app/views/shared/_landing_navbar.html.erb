<!-- app/views/shared/_landing_navbar.html.erb -->
<nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-sm border-b border-gray-100 transition-all duration-300" data-controller="navigation">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo - Always clickable, redirects to root -->
      <%= link_to root_path, class: "flex items-center gap-2 hover:opacity-80 transition-opacity" do %>
        <span class="text-2xl">💰</span>
        <span class="text-xl font-bold text-gray-900">Expense Tracker</span>
      <% end %>

      <!-- Desktop Navigation (Landing Page) -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#features" class="text-gray-600 hover:text-gray-900 transition-colors text-sm font-medium">Features</a>
        <a href="#stats" class="text-gray-600 hover:text-gray-900 transition-colors text-sm font-medium">Stats</a>
        <a href="#testimonials" class="text-gray-600 hover:text-gray-900 transition-colors text-sm font-medium">Reviews</a>
        <a href="#contact" class="text-gray-600 hover:text-gray-900 transition-colors text-sm font-medium">Contact</a>
      </div>

      <!-- Auth Buttons -->
      <div class="flex items-center gap-3">
        <%= link_to "Sign In", new_user_session_path, class: "hidden md:inline-block px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors" %>
        <%= link_to "Get Started", new_user_registration_path, class: "px-4 py-2 text-sm font-semibold text-white bg-gradient-to-r from-purple-600 to-indigo-600 rounded-xl hover:shadow-lg transform hover:scale-105 transition-all duration-200" %>
        
        <!-- Mobile Menu Button -->
        <button class="md:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors" data-action="click->navigation#toggleMobileMenu">
          <i class="fas fa-bars text-gray-600 text-xl"></i>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div class="md:hidden hidden py-4 border-t border-gray-100" data-navigation-target="mobileMenu">
      <div class="flex flex-col gap-3">
        <a href="#features" class="text-gray-600 hover:text-gray-900 transition-colors py-2 px-3 hover:bg-gray-50 rounded-lg">Features</a>
        <a href="#stats" class="text-gray-600 hover:text-gray-900 transition-colors py-2 px-3 hover:bg-gray-50 rounded-lg">Stats</a>
        <a href="#testimonials" class="text-gray-600 hover:text-gray-900 transition-colors py-2 px-3 hover:bg-gray-50 rounded-lg">Reviews</a>
        <a href="#contact" class="text-gray-600 hover:text-gray-900 transition-colors py-2 px-3 hover:bg-gray-50 rounded-lg">Contact</a>
        <hr class="border-gray-100">
        <%= link_to "Sign In", new_user_session_path, class: "text-gray-600 hover:text-gray-900 transition-colors py-2 px-3 hover:bg-gray-50 rounded-lg" %>
        <%= link_to "Get Started", new_user_registration_path, class: "text-purple-600 font-semibold py-2 px-3 hover:bg-purple-50 rounded-lg" %>
      </div>
    </div>
  </div>
</nav>